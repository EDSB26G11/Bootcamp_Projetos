reports/*.html

# Modelos treinados (gerados por src/models/train.py, save_model)
models/*
!models/.gitkeep


# VS Code workspace files
*.code-workspace
# Notas internas locais (não partilhar)
docs/status_apoio_ia.md
docs/contributions.md

# Previsões out-of-fold (geradas pelo notebook 04)
reports/oof_*.csv

# Avaliação interna do projeto (não entregar)
docs/avaliacao_interna.md
